NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only -- Dashboard > Settings > API > service_role. Required for
# the "Delete account" feature (auth.admin.deleteUser). Never expose to
# the client / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only -- encrypts the AI provider API keys users add on /ask, so a
# database dump alone never yields a usable key. Must decode to 32 bytes;
# generate with `openssl rand -base64 32` (hex is also accepted). Never expose
# to the client / never prefix with NEXT_PUBLIC_. Changing or losing this
# makes every already-stored key undecryptable -- users would have to re-add
# them -- so treat it as permanent once real keys exist.
AI_KEY_ENCRYPTION_SECRET=

# Error monitoring (Sentry). DSN is the same value client + server side --
# it's meant to be public, unlike SENTRY_AUTH_TOKEN below.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional -- only needed to upload source maps at build time. Sentry
# dashboard > Settings > Auth Tokens (needs project:releases scope).
SENTRY_AUTH_TOKEN=

# Cloudflare Turnstile site key -- the CAPTCHA on the four auth screens that
# call Supabase Auth directly from the browser (sign in, sign up, password
# reset, resend confirmation). Public by design: it ships in the client
# bundle, which is why it carries the NEXT_PUBLIC_ prefix.
#
# The matching SECRET key goes into the Supabase dashboard (Authentication >
# Settings > Bot and Abuse Protection), which verifies the sign-in tokens. It
# is never a NEXT_PUBLIC_ value. The Get help form needs it on our server too:
# see TURNSTILE_SECRET_KEY below.
#
# Leaving this unset is safe: src/components/turnstile.tsx renders nothing and
# passes no token, so the app behaves exactly as it did before CAPTCHA. That
# is what lets the code deploy BEFORE the Supabase toggle is flipped -- doing
# it the other way round breaks auth for everyone until the deploy lands.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# The SAME widget's SECRET key, for our own server's check on the Get help
# form (src/lib/help/turnstile-verify.ts) -- unlike sign-in, that form writes
# to our database, so Supabase can't check it for us. Server only, never
# NEXT_PUBLIC_. Cloudflare dashboard -> Turnstile -> the widget -> Settings.
# In production the help form refuses requests until this is set.
TURNSTILE_SECRET_KEY=

# Server-only -- bearer secret for the nightly /api/cron/auto-execute job.
# The scheduler sends it; the route compares it in constant time.
CRON_SECRET=

# Server-only -- during an encryption-secret rotation, the OLD value, so keys
# stored under it can still be read and re-encrypted (npm run rotate:ai-keys).
# Remove once rotation is done (SECURITY-RUNBOOK.md §6).
AI_KEY_ENCRYPTION_SECRET_PREVIOUS=
# "true" once migration 0058 is applied: keys are written in the v3 format.
AI_KEY_WRITE_V3=

# Kill switch: "false" writes the session cookie script-readable again (not
# HttpOnly). Leave empty: HttpOnly is the default (src/lib/supabase/cookie-options.ts).
AUTH_COOKIE_HTTPONLY=

# Optional: one of Supabase's NEW secret keys (sb_secret_..., Dashboard -> Project
# Settings -> API Keys). When set, sign-in and sign-up forward the visitor's IP
# to Supabase (Sb-Forwarded-For), so its per-IP limits count real visitors
# instead of our server. Also switch forwarding on in Authentication -> Rate
# Limits. Server only; leave empty to keep using our own limits alone.
SUPABASE_AUTH_SECRET_KEY=

# Kill switch: "true" sends the CSP as report-only instead of enforcing it,
# without a redeploy, if a missed origin ever breaks a page in production.
CSP_REPORT_ONLY=

# Scripts only, never the app: the demo account's password, written by
# `node scripts/set-demo-password.mjs --apply` and read by
# scripts/seed-demo-account.mjs. Never a literal in a committed file.
DEMO_ACCOUNT_PASSWORD=

# Not here, on purpose:
# - SUPABASE_DEV_URL / SUPABASE_DEV_ANON_KEY / SUPABASE_DEV_SERVICE_ROLE_KEY
#   live in .env.test.local (the separate DEV project for test:idor, e2e,
#   seed:fake and dev:devdb; see docs/dev-accounts.md).
# - BACKUP_PASSPHRASE is a GitHub Actions secret (.github/workflows/backup.yml).
# - TJ_TEST_EMAIL / TJ_TEST_PASSWORD are passed inline to
#   scripts/check-rpc-parity.ts when it is run.
# - URL / DEPLOY_PRIME_URL (Netlify sets them on every build and function),
#   NODE_ENV / NEXT_RUNTIME (Node and Next set them), and SUPABASE_PROD_URL
#   (tests only: the production URL they refuse to run against).
