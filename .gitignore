# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-out.log
dev-err.log
dev-local.log

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which is documentation and holds no values. Without
# this negation `.env*` above swallows it, so it was untracked and every
# "documented in .env.local.example" note reached nobody but whoever wrote it.
!.env.local.example

# DB backups (scripts/backup-db.ts) -- real user data, never commit
/backups/

# Artifacts from .github/workflows/backup.yml, and whatever a restore test
# leaves behind. /backups/ above does not cover these: they land in the repo
# ROOT, because that is where you unzip the artifact and where `tar -xzf`
# is run from. The decrypted tarball in particular is every user's journal in
# plaintext, one `git add -A` away from a public repo.
/backup.tar.gz
/trading-lens-backup-*.tar.gz
/trading-lens-backup-*.tar.gz.gpg

# Playwright output. test-results/ holds failure traces and screenshots, which
# are recordings of a signed-in session against the real project -- never
# commit them.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Ad-hoc admin/seed scratch scripts kept in the repo root so they can resolve
# node_modules. They run against the live database with the service-role key
# and are not part of the app.
*.tmp.mjs

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# optional PP-OCRv4 "server" OCR model weights (~200MB, opt-in via
# OCR_MODEL_VARIANT=server) — not accurate/fast enough to be worth committing,
# see scripts/ocr-eval/README.md
/models/paddleocr-server/*.onnx

# Playwright MCP browser artifacts (snapshots, console logs)
.playwright-mcp/
