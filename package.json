{
  "name": "trading-journal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ocr:fixtures": "tsx scripts/ocr-eval/generate.ts",
    "ocr:eval": "tsx scripts/ocr-eval/run.ts",
    "backup:db": "tsx --env-file-if-exists=.env.local scripts/backup-db.ts",
    "restore:db": "tsx --env-file-if-exists=.env.local scripts/restore-db.ts",
    "migrations:status": "tsx --env-file=.env.local scripts/migrations-status.ts",
    "verify:ai-secret": "tsx --conditions=react-server --env-file=.env.local scripts/verify-ai-key-secret.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "tsx --env-file=.env.local scripts/check-bundle-secrets.ts"
  },
  "dependencies": {
    "@gutenye/ocr-node": "^1.4.8",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.42.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.23.0",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "sharp@0.33.5": true,
    "onnxruntime-node@1.27.0": true,
    "tesseract.js@7.0.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true,
    "@sentry/cli@2.58.6": true,
    "sharp@0.35.4": true
  },
  "overrides": {
    "sharp": "^0.35.4",
    "nanoid": "^3.3.18",
    "adm-zip": "^0.6.0",
    "brace-expansion@1.x": "^1.1.18",
    "brace-expansion@2.x": "^2.1.4",
    "uuid": "^11.1.1"
  }
}
