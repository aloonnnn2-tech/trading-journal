{
  "name": "trading-journal",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ocr:fixtures": "tsx scripts/ocr-eval/generate.ts",
    "ocr:eval": "tsx scripts/ocr-eval/run.ts",
    "ocr:record": "tsx scripts/ocr-eval/record.ts",
    "ocr:eval-ai": "tsx scripts/ocr-eval/run-ai.ts",
    "backup:db": "tsx --env-file-if-exists=.env.local scripts/backup-db.ts",
    "restore:db": "tsx --env-file-if-exists=.env.local scripts/restore-db.ts",
    "restore:storage": "tsx --env-file-if-exists=.env.local scripts/restore-storage.ts",
    "migrations:status": "tsx --env-file=.env.local scripts/migrations-status.ts",
    "dev-schema": "tsx scripts/build-dev-schema.ts",
    "verify:ai-secret": "tsx --conditions=react-server --env-file=.env.local scripts/verify-ai-key-secret.ts",
    "rotate:ai-keys": "tsx --conditions=react-server --env-file=.env.local scripts/rotate-ai-keys.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:idor": "vitest run --config vitest.idor.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:bundle": "tsx --env-file=.env.local scripts/check-bundle-secrets.ts",
    "check:cache-secrets": "tsx --env-file=.env.local scripts/check-cache-secrets.ts",
    "check:design-v2": "tsx scripts/check-design-v2-scope.ts",
    "check:ai-models": "tsx --env-file-if-exists=.env.local scripts/check-ai-models.ts",
    "ask:bench": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/ask-bench/run.ts",
    "shots:marketing": "node scripts/capture-marketing-shots.mjs",
    "accounts:list": "tsx --env-file=.env.local scripts/list-accounts.ts",
    "accounts:summary": "tsx --env-file=.env.local scripts/accounts-summary.ts",
    "seed:fake": "tsx scripts/seed-fake-data.mjs",
    "dev:devdb": "tsx scripts/dev-on-dev-project.ts",
    "ocr:web": "tsx scripts/ocr-eval/web-replay.ts"
  },
  "dependencies": {
    "@gutenye/ocr-node": "^1.4.8",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.42.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.23.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "sharp@0.33.5": true,
    "onnxruntime-node@1.27.0": true,
    "tesseract.js@7.0.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true,
    "@sentry/cli@2.58.6": true,
    "sharp@0.35.4": true,
    "sharp@0.35.5": true
  },
  "overrides": {
    "sharp": "^0.35.5",
    "nanoid": "^3.3.18",
    "adm-zip": "^0.6.0",
    "brace-expansion@1.x": "^1.1.21",
    "brace-expansion@2.x": "^2.1.7",
    "uuid": "^11.1.1",
    "brace-expansion@5.x": "^5.0.12",
    "source-map-js": "^1.2.2",
    "fast-uri": "^3.1.8"
  }
}
